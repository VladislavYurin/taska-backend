# Copy to .env.oauth (ignored by Git), or inject these variables only into auth-service.
# docker-compose.yml loads this optional file ONLY in auth-service.
# Never put provider secrets in the shared .env, which is used by other containers.
TASKA_OAUTH_GOOGLE_ENABLED=false
TASKA_OAUTH_GOOGLE_CLIENT_ID=
TASKA_OAUTH_GOOGLE_CLIENT_SECRET=
TASKA_OAUTH_GITHUB_ENABLED=false
TASKA_OAUTH_GITHUB_CLIENT_ID=
TASKA_OAUTH_GITHUB_CLIENT_SECRET=
TASKA_OAUTH_APPLE_ENABLED=false
TASKA_OAUTH_APPLE_SERVICE_ID=
TASKA_OAUTH_APPLE_TEAM_ID=
TASKA_OAUTH_APPLE_KEY_ID=
# PKCS#8 .p8 PEM; literal \n is accepted. No pre-generated client_secret is configured.
TASKA_OAUTH_APPLE_PRIVATE_KEY=

# Shared durable budget across start/callback/exchange/signup for each client IP.
TASKA_OAUTH_IP_ATTEMPTS_PER_HOUR=240
