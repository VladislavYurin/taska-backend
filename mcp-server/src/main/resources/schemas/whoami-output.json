{
  "type": "object",
  "required": [
    "request_id",
    "truncated"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    },
    "data": {
      "type": "object",
      "required": [
        "user",
        "token_kind",
        "scopes",
        "expires_at"
      ],
      "properties": {
        "user": {
          "type": "object",
          "required": [
            "avatarUnavailable"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "displayName": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "INVITED",
                "ACTIVE",
                "BLOCKED",
                "LOCKED",
                "UNSPECIFIED"
              ]
            },
            "globalRole": {
              "type": "string",
              "enum": [
                "GLOBAL_ADMIN",
                "USER",
                "UNSPECIFIED"
              ]
            },
            "avatar": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "objectKey": {
                      "type": "string"
                    },
                    "fileName": {
                      "type": "string"
                    },
                    "contentType": {
                      "type": "string"
                    },
                    "downloadUrl": {
                      "type": "string"
                    },
                    "sizeBytes": {
                      "type": "integer"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "avatarUnavailable": {
              "type": "boolean"
            }
          }
        },
        "token_kind": {
          "type": "string",
          "enum": [
            "PAT",
            "OAUTH"
          ]
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required_scope": {
              "type": "string"
            },
            "retry_after_seconds": {
              "type": "integer"
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "data"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "required": [
        "error"
      ],
      "not": {
        "required": [
          "data"
        ]
      }
    }
  ]
}
