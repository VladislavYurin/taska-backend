  "impactRules": [
    {
      "prefixes": [
        "auth-service/",
        "project-service/",
        "issue-service/",
        "kafka-lib/"
      ],
      "modules": [
        "notification-service"
      ],
      "reason": "Domain event producer/outbox changes can affect notification consumers."
    },
    {
      "prefixes": [
        "workflow-service/",
        "project-service/",
        "issue-service/"
      ],
      "modules": [
        "workflow-service",
        "project-service",
        "issue-service",
        "api-gateway",
        "mcp-server"
      ],
      "reason": "Workflow/type bindings cross service boundaries."
    },
    {
      "prefixes": [
        "oauth-server/",
        "auth-service/",
        "api-gateway/",
        "mcp-server/"
      ],
      "modules": [
        "oauth-server",
        "auth-service",
        "api-gateway",
        "mcp-server"
      ],
      "reason": "Identity, REST and MCP share trust and token contracts."
    },
    {
      "prefixes": [
        "infra/",
        "docker-compose",
        ".env.docker.example",
        ".env.oauth.example"
      ],
      "groups": [
        "config"
      ],
      "reason": "Compose/infrastructure configuration checks."
    },
    {
      "prefixes": [
        "scripts/harness",
        ".github/workflows/pr-check.yml",
        ".github/codex/"
      ],
      "groups": [
        "harness",
        "docs"
      ],
      "reason": "Harness/CI/review changes require self-tests and documentation checks."
    }
  ]
}
