  "capabilities": {
    "git": {
      "argv": [
        "git",
        "--version"
      ]
    },
    "java": {
      "argv": [
        "java",
        "-version"
      ]
    },
    "python": {
      "argv": [
        "{python}",
        "--version"
      ]
    },
    "node": {
      "argv": [
        "node",
        "--version"
      ]
    },
    "docker": {
      "argv": [
        "docker",
        "info",
        "--format",
        "{{.ServerVersion}}"
      ]
    },
    "compose": {
      "argv": [
        "docker",
        "compose",
        "version"
      ]
    }
  },
