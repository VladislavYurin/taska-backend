      "id": "common-lib.verify",
      "module": "common-lib",
      "group": "java",
      "tier": "integration",
      "argv": [
        "./mvnw",
        "-B",
        "-ntp",
        "-pl",
        "common-lib",
        "-am",
        "clean",
        "verify"
      ],
      "workdir": ".",
      "prerequisites": [
        "git",
        "java"
      ],
      "timeout": 1800,
      "reports": {
        "directory": "common-lib/target/surefire-reports",
        "selectors": [
          "*"
        ],
        "noTestsReason": null
      },
      "requires": [],
      "writeScope": [
        "*/target/",
        "local Maven cache"
      ]
