# Конфигурация Lombok для модуля auth-service.
#
# AuthServiceImpl инжектит TransactionalOperator через @Qualifier, потому что
# в контексте два бина этого типа:
#   - transactionalOperator            (PROPAGATION_REQUIRED)
#   - requiresNewTransactionalOperator (PROPAGATION_REQUIRES_NEW)
#
# Без этой конфигурации Lombok игнорирует @Qualifier на поле при генерации
# конструктора через @RequiredArgsConstructor.
#
# С помощью `lombok.copyableAnnotations` Lombok переносит @Qualifier с поля
# на параметр сгенерированного конструктора, и Spring явно выбирает
# нужный бин.

# Прекращаем поиск родительских lombok.config.
config.stopBubbling = true

# Переносить @Qualifier с полей на параметры конструктора, чтобы
# @RequiredArgsConstructor сохранял его для инъекции Spring.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier