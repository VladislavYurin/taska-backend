# ============================================
# ОБЩИЕ ПЕРЕМЕННЫЕ
# ============================================

KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ============================================
# POSTGRES
# ============================================

# Posgres user
POSTGRES_USER=taska
POSTGRES_PASSWORD=taska

# DB names
AUTH_DB_NAME=auth_db
PROJECT_DB_NAME=project_db
WORKFLOW_DB_NAME=workflow_db
ISSUE_DB_NAME=issue_db
NOTIFICATION_DB_NAME=notification_db
ADMIN_DB_NAME=admin_db

# ============================================
# PGADMIN
# ============================================

PGADMIN_DEFAULT_EMAIL=admin@taska.com
PGADMIN_DEFAULT_PASSWORD=admin

# ============================================
# MINIO
# ============================================

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_AVATARS=taska-avatars
MINIO_BUCKET_ATTACHMENTS=taska-attachments
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_PRESIGNED_URL_TTL=15m

# ============================================
# KAFKA
# ============================================

# KRaft single-node
KAFKA_ENABLE_KRAFT=yes
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_CLUSTERS_0_NAME=taska-kafka
DYNAMIC_CONFIG_ENABLED=true

# listeners
KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT

# dev-friendly
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_NUM_PARTITIONS=3
KAFKA_DEFAULT_REPLICATION_FACTOR=1
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1

ALLOW_PLAINTEXT_LISTENER=yes

# ============================================
# GRAFANA
# ============================================

GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
GF_USERS_DEFAULT_THEME=light

# ============================================
# AUTH-SERVICE
# ============================================

# Ports
AUTH_SERVER_PORT=8080
AUTH_GRPC_SERVER_PORT=9090

# DB
AUTH_SPRING_R2DBC_URL=r2dbc:postgresql://auth-db:5432/auth_db
AUTH_SPRING_R2DBC_USERNAME=taska
AUTH_SPRING_R2DBC_PASSWORD=taska

# Liquibase
AUTH_SPRING_LIQUIBASE_URL=jdbc:postgresql://auth-db:5432/auth_db
AUTH_SPRING_LIQUIBASE_USERNAME=taska
AUTH_SPRING_LIQUIBASE_PASSWORD=taska

# Kafka
AUTH_KAFKA_TOPIC_USER_EVENTS=user.events
AUTH_KAFKA_OUTBOX_POLLING_INTERVAL=3s
AUTH_KAFKA_OUTBOX_RECOVERY_INTERVAL=10s
AUTH_KAFKA_OUTBOX_BATCH_SIZE=100
AUTH_KAFKA_OUTBOX_MAX_ATTEMPTS=5
AUTH_KAFKA_OUTBOX_PROCESSING_TIMEOUT=5m

# Jwt
JWT_SECRET=your-256-bit-secret-key-for-jwt-signing-and-validation-must-be-long-enough
AUTH_JWT_ACCESS_TTL=15m
AUTH_JWT_REFRESH_TTL=7d
AUTH_JWT_INVITE_TTL=7d

# Security
AUTH_SECURITY_MAX_FAILED_ATTEMPTS=5
AUTH_SECURITY_LOCK_DURATION=15m
AUTH_PASSWORD_ENCODER=bcrypt

# Password Policy
AUTH_PASSWORD_MIN_LEN=8
AUTH_PASSWORD_MAX_LEN=128
AUTH_PASSWORD_REQUIRE_UPPER=true
AUTH_PASSWORD_REQUIRE_DIGIT=true
AUTH_PASSWORD_REQUIRE_SPECIAL=true

# Logs
AUTH_LOG_LEVEL_ROOT=INFO
AUTH_LOG_LEVEL_LIQUIBASE=INFO
AUTH_LOG_LEVEL_KAFKA=WARN

