# Business settings
ISSUE_LIST_DEFAULT_PAGE_SIZE=20
ISSUE_LIST_MAX_PAGE_SIZE=100
ISSUE_CARD_MAX_HISTORY_SIZE=50
ISSUE_CREATE_ROLES=ADMIN,MEMBER
ISSUE_ASSIGN_ROLES=ADMIN,MEMBER
ISSUE_DELETE_ROLES=ADMIN,MEMBER
ISSUE_UPDATE_ROLES=ADMIN,MEMBER
ISSUE_TRANSITION_ROLES=ADMIN,MEMBER
ISSUE_GET_ROLES=ADMIN,MEMBER,VIEWER
ISSUE_LIST_ROLES=ADMIN,MEMBER,VIEWER
ISSUE_UPLOAD_ATTACHMENT_ROLES=ADMIN,MEMBER
ISSUE_VIEW_ATTACHMENT_ROLES=ADMIN,MEMBER,VIEWER
ISSUE_DELETE_ATTACHMENT_ROLES=ADMIN
ISSUE_IDEMPOTENCY_TTL=24h
ISSUE_TRANSITION_RETRY_MAX_ATTEMPTS=2
ISSUE_TRANSITION_RETRY_MIN_BACKOFF:100ms

# gRPC client
PROJECT_GRPC_HOST=project-service
PROJECT_GRPC_PORT=9090
WORKFLOW_GRPC_HOST=workflow-service
WORKFLOW_GRPC_PORT=9090

# Logs
ISSUE_LOG_LEVEL_ROOT=INFO
ISSUE_LOG_LEVEL_LIQUIBASE=INFO
ISSUE_LOG_LEVEL_KAFKA=WARN

